# Bu dosyayı "keystore.properties" olarak kopyala (aynı klasörde, android/
# içinde) ve kendi değerlerinle doldur. GERÇEK keystore.properties dosyası
# git'e ASLA girmemeli (android/.gitignore zaten engelliyor) — şifreleri
# ayrıca bir parola yöneticisinde yedekle, kaybedersen bu uygulamayı Play
# Store'da bir daha güncelleyemezsin. Kurulum adımları: android/RELEASE.md
storeFile=cicidolap-release.jks
storePassword=BURAYA_KEYSTORE_SIFRESI
keyAlias=cicidolap
keyPassword=BURAYA_ANAHTAR_SIFRESI
