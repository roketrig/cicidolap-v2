rules_version = '2';

// Cici Dolap - Firestore Güvenlik Kuralları
//
// NEDEN GEREKLİ: Uygulamanın admin kontrolü (App.jsx / AdminPanel.jsx /
// ProductDetail.jsx) sadece arayüzde "admin@cici-dolap.com" e-postasını
// kontrol ediyor. Bu, hangi butonların gösterileceğini belirler ama
// Firestore'a doğrudan istek atan biri için hiçbir engel oluşturmaz —
// gerçek güvenlik burada, sunucu tarafında sağlanmalı. Bu dosyayı
// Firebase Console > Firestore Database > Rules sekmesine yapıştırıp
// "Yayınla" demeden hiçbir koruma devreye girmez.
//
// Not: Admin yetkisi burada da e-posta karşılaştırmasıyla yapılıyor
// (custom claim / Cloud Function altyapısı projede yok). Bu, tek admin
// hesabı için yeterlidir; birden fazla admin/moderatör gerektiğinde
// Firebase Admin SDK ile custom claim atayan bir Cloud Function'a
// geçmeniz önerilir.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'admin@cici-dolap.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Yönetici tarafından kısıtlanmış (yasaklı) hesap mı? (bkz. "bans")
    function isBanned() {
      return isSignedIn()
             && exists(/databases/$(database)/documents/bans/$(request.auth.uid));
    }

    // "blocker", "blocked" kullanıcısını engellemiş mi? (bkz. "blocks")
    function hasBlocked(blocker, blocked) {
      return exists(/databases/$(database)/documents/blocks/$(blocker + '_' + blocked));
    }

    match /products/{productId} {
      // Herkes onaylı ürünleri görebilir; sahibi kendi ürününü (pending/
      // rejected dahil) görebilir; admin hepsini görebilir.
      allow read: if resource.data.status == 'approved'
                  || isOwner(resource.data.userId)
                  || isAdmin();

      // Ürün eklerken: giriş yapmış olmalı, userId/userEmail kendi
      // hesabıyla eşleşmeli, ve durum her zaman "pending" olarak
      // başlamalı (kimse kendi ürününü doğrudan "approved" yapamaz).
      // Admin istisnası: örnek/vitrin ürünü eklerken (bkz.
      // scripts/seedProducts.js) doğrudan "approved" oluşturabilir.
      allow create: if isAdmin()
                    || (
                      isSignedIn()
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.userEmail == request.auth.token.email
                      && request.resource.data.status == 'pending'
                      && !isBanned()
                    );

      // Güncelleme: admin her alanı değiştirebilir (onayla/reddet dahil).
      // Sahibi kendi ürününü güncelleyebilir (başlık, açıklama, "sold"
      // durumu vb.) ama userId/userEmail/status alanlarını değiştiremez
      // — yoksa kendi ürününü "approved" yapabilir ya da başka bir
      // kullanıcıya devredebilirdi.
      allow update: if isAdmin()
                    || (
                      isOwner(resource.data.userId)
                      && request.resource.data.userId == resource.data.userId
                      && request.resource.data.userEmail == resource.data.userEmail
                      && request.resource.data.status == resource.data.status
                    );

      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }

    // Çift yönlü mesajlaşma (bkz. src/chat.js). Her ürün + alıcı çifti
    // için tek bir konuşma dokümanı ve altında "messages" alt koleksiyonu
    // var. Eski tek yönlü "messages" kök koleksiyonunun yerini aldı.
    match /conversations/{cid} {
      function isParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }

      // Sadece konuşmanın iki tarafı okuyabilir/listeleyebilir.
      // "resource == null" hâli: var olmayan bir dokümanı get() ile
      // sorgularken (src/chat.js konuşma açmadan önce kontrol ediyor)
      // kural resource.data'ya erişemeyip hata verirdi — bu da "yok"
      // yerine "izin yok" hatasına dönüşüyordu.
      allow read: if isSignedIn()
                  && (resource == null || request.auth.uid in resource.data.participants);

      // Konuşmayı yalnızca alıcı başlatır. participants tam olarak
      // [sellerId, buyerId] olmalı, alıcı kendine yazamaz ve doküman
      // kimliği "{productId}__{buyerId}" formatında olmalı.
      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.buyerId
                    && request.resource.data.buyerId != request.resource.data.sellerId
                    && request.resource.data.participants.hasOnly([request.resource.data.sellerId, request.resource.data.buyerId])
                    && request.resource.data.participants.hasAll([request.resource.data.sellerId, request.resource.data.buyerId])
                    && cid == request.resource.data.productId + '__' + request.resource.data.buyerId
                    && !isBanned()
                    && !hasBlocked(request.resource.data.sellerId, request.auth.uid);

      // Güncelleme: sadece taraflar; ve yalnızca "son mesaj özeti" +
      // okundu bilgisi alanları değişebilir. Kimlik alanları (participants
      // / sellerId / buyerId / productId / productTitle ...) affectedKeys
      // kısıtı sayesinde dokunulamaz.
      allow update: if isParticipant()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['lastText', 'lastAt', 'lastSenderId', 'lastReadAt']);

      allow delete: if false;

      match /messages/{mid} {
        function participants() {
          return get(/databases/$(database)/documents/conversations/$(cid)).data.participants;
        }

        allow read: if isSignedIn() && request.auth.uid in participants();

        // Karşı taraf bu kullanıcıyı engellediyse (ya da kullanıcı yasaklıysa)
        // mesaj yazılamaz.
        function recipientId() {
          return get(/databases/$(database)/documents/conversations/$(cid)).data.sellerId == request.auth.uid
            ? get(/databases/$(database)/documents/conversations/$(cid)).data.buyerId
            : get(/databases/$(database)/documents/conversations/$(cid)).data.sellerId;
        }

        allow create: if isSignedIn()
                      && request.auth.uid == request.resource.data.senderId
                      && request.auth.uid in participants()
                      && !isBanned()
                      && !hasBlocked(recipientId(), request.auth.uid)
                      && !hasBlocked(request.auth.uid, recipientId())
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 2000;

        allow update, delete: if false;
      }
    }

    // İlan sahibinin telefon numarası. KVKK gereği ürün dokümanında
    // (herkese açık) DEĞİL, burada ayrı tutuluyor ve yalnızca giriş yapmış
    // kullanıcılar okuyabiliyor. Numara ancak ilan sahibi "contactPref:
    // phone" seçip açık rıza verdiyse oluşturuluyor (bkz. AddProduct.jsx).
    match /listingContacts/{productId} {
      allow read: if isSignedIn();

      allow create, update: if isSignedIn()
                            && (request.auth.uid == request.resource.data.sellerId || isAdmin())
                            && request.resource.data.phone is string;

      allow delete: if isSignedIn()
                    && (isAdmin() || resource.data.sellerId == request.auth.uid);
    }

    match /favorites/{favId} {
      // Doküman kimliği her zaman "{uid}_{productId}" formatında —
      // bu sayede bir kullanıcının favorisini başka biri okuyamaz/
      // silemez/üstüne yazamaz, ve aynı ürünü iki kez favorileyemez
      // (aynı id'ye tekrar yazmak "create" değil zaten var olan
      // dokümanı değiştirmek anlamına gelir, o da izinli değil).
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && favId == request.auth.uid + '_' + request.resource.data.productId;

      allow update: if false;

      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ŞİKAYETLER (Google Play UGC politikası + App Store 1.2). Giriş yapmış
    // herkes şikayet oluşturabilir, ama kayıtları sadece admin okuyup
    // yönetebilir. Kullanıcı kendi şikayetini sonradan değiştiremez.
    match /reports/{reportId} {
      allow create: if isSignedIn()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.type in ['listing', 'user', 'conversation']
                    && request.resource.data.targetId is string
                    && request.resource.data.reason is string
                    && request.resource.data.status == 'open'
                    && (!('details' in request.resource.data) || request.resource.data.details.size() <= 1000);

      allow read, update, delete: if isAdmin();
    }

    // ENGELLEMELER: doküman kimliği "{engelleyen}_{engellenen}". Yalnızca
    // engelleyen kendi kayıtlarını okuyabilir/oluşturabilir/silebilir.
    // (Engellenen kişi kaydı göremez; mesaj kuralları exists() ile kontrol eder.)
    match /blocks/{blockId} {
      allow read: if isSignedIn() && resource.data.blockerId == request.auth.uid;

      allow create: if isSignedIn()
                    && request.resource.data.blockerId == request.auth.uid
                    && request.resource.data.blockedId != request.auth.uid
                    && blockId == request.auth.uid + '_' + request.resource.data.blockedId;

      allow update: if false;

      allow delete: if isSignedIn() && resource.data.blockerId == request.auth.uid;
    }

    // YASAKLAR: admin yazar; kullanıcı yalnızca kendi kaydının varlığını görür.
    match /bans/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Tanımlanmamış her şey varsayılan olarak kapalı.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
