rules_version = '2';

// ⚠️ ARTIK KULLANILMIYOR ⚠️
//
// Firebase Storage bucket'ı hiç oluşturulamadığı için ürün görselleri
// Cloudflare R2'ye taşındı (bkz. cloudflare-worker/ klasörü ve
// src/imageUpload.js). Bu dosyayı Firebase Console'a yapıştırmanıza
// gerek yok — sadece referans/geçmiş olarak burada duruyor. Storage'ı
// ileride tekrar aktif ederseniz aşağıdaki kurallar hâlâ geçerlidir.
//
// --- Eski açıklama ---
// Cici Dolap - Firebase Storage Güvenlik Kuralları
//
// AddProduct.jsx artık ürün görsellerini "products/{kullanıcıId}/dosya"
// yoluna yüklüyor (eskiden herkesin aynı "products/" klasörüne yazdığı,
// dosya adı çakışması ve kimin ne yüklediğini ayırt edememe riski taşıyan
// bir yapıydı). Bu kural sayesinde bir kullanıcı sadece kendi klasörüne
// yazabiliyor, resimler 5MB ile sınırlı ve sadece resim dosyalarına
// izin veriliyor. Bu dosyayı Firebase Console > Storage > Rules
// sekmesine yapıştırıp yayınlamanız gerekir.

service firebase.storage {
  match /b/{bucket}/o {
    match /products/{userId}/{fileName} {
      // Ürün görselleri herkese açık gösteriliyor (ana sayfa, ürün
      // detayı vb. giriş yapmamış ziyaretçilere de görünüyor).
      allow read: if true;

      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
